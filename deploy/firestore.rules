// The store, with sign-in, for the prototype.
//
// This is the alternative to deploy/worker.js, and the better one now that sign-in is on the
// table. There is no program of ours in the middle: the page talks to the database, and Google
// enforces these rules on every request. That is how a phone app talks to Firebase, and it is
// what makes per-person access possible.
//
// WHY THIS BEATS THE WORKER
//
//   A Canadian region can be chosen. Create the database in northamerica-northeast1, which is
//   Montreal. Cloudflare cannot offer that.
//
//   Nothing can be listed without an account. That is the property that matters: an assessment
//   is reachable only by naming it, and its name is a twelve-character code somebody was sent.
//   See the comment on `allow get` for what that grants and what it costs.
//
//   Roles live in the database, so an admin grants them and the rules enforce them.
//
// WHAT SOMEBODY HAS TO DO ONCE
//
//   1. console.firebase.google.com, add a project. No card.
//   2. Build > Firestore Database > Create, and choose northamerica-northeast1 (Montreal).
//      The region cannot be changed afterwards, so choose it now.
//   3. Build > Authentication > Sign-in method > Email link (passwordless sign-in), enable.
//      A person types their work address and clicks the link in the mail. No password exists.
//   4. Paste these rules into Firestore Database > Rules and publish.
//   5. Project settings > General > Your apps > Web, register one, copy the config.
//   6. Firestore Database > Data, create a document at roles/<your-email> with
//      { "role": "admin" }. That is the first admin, and from then on an admin makes the rest.
//
// WHAT EVERY RULE COSTS
//
// An exists() or a get() inside a rule is a billable document read, even when the request is
// then denied. So the common path is written to need neither: isOwner() compares the signed-in
// email against a field already in the document being read, and the || short-circuits, so a
// submitter reading their own assessment triggers no lookup at all. Only the assessor and
// admin paths call get() on the roles document.
//
// THE RULES BELOW, IN WORDS
//
//   A signed-in person may create an assessment and read and change their own.
//   Anybody holding an assessment's code may create it, open it, and change it. The code is the
//   document's name, so holding it and being able to name the document are the same fact.
//   They may not list anything, create anything, delete anything, read the assessor's audit
//   subcollection, move the record to another account, or touch the audit or the withdrawal.
//   An assessor may read every submitted assessment and write the audit on it, and may never
//   touch anybody's answers or evidence.
//   An admin may do what an assessor may, plus grant roles, plus delete a record.
//   A submitter may never delete anything, and Google enforces that.
//
// WHY AN ADMIN CAN DELETE
//
// A prototype fills up with test submissions, and somebody has to be able to clear them. The
// protection is not the rule, it is the way the tool asks: deleting a record makes the admin
// type the initiative name out, copied from the way GitHub deletes a repository. A
// confirmation somebody can agree to by reflex stops being a confirmation.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Who is who. Only an admin writes here, so a person cannot promote themselves.
    match /roles/{email} {
      allow get: if request.auth != null && request.auth.token.email == email;
      allow list, create, update: if isAdmin();
      allow delete: if false;
    }

    match /assessments/{id} {
      /**
       * Creating, by an account or by whoever minted the code.
       *
       * An assessment now has its code from the moment it is created in the browser, before it
       * has ever been online, which is what makes the code the one thing a person keeps. So the
       * first save is a create by somebody who may have no account at all, and requiring one
       * here would put the account back on the submitter that this whole design removes.
       *
       * What is asked instead: the name has to be a code this tool would mint, and the body has
       * to be an assessment. Neither is a security control and neither pretends to be. They stop
       * this collection being used as free storage for something else, which is the only abuse
       * here that costs storage rather than one recoverable day of reads.
       *
       * A signed-in person still writes their address on it, and that is what later pins the
       * record to them: ownerEmail cannot be changed afterwards by anybody.
       */
      allow create: if (signedIn() && request.resource.data.ownerEmail == email())
                    || (isCodeShaped(id) && looksLikeAnAssessment());

      /**
       * Naming the document IS holding the access code.
       *
       * The id is the code: twelve characters from a 32-symbol alphabet with I, O, 0 and 1
       * taken out, so 2^60. A request that names one has been sent it or has guessed one in a
       * billion billion. Nothing can be listed without an account, so naming is the only way
       * in, and that is what makes an unguessable name worth anything.
       *
       * This is the line that makes the whole of sharing work. Before it, a person holding a
       * code was refused, so the code meant nothing and every screen that offered it was
       * describing a mechanism the store did not have.
       *
       * WHAT IT COSTS, PLAINLY
       *
       * An assessment is readable by anybody who obtains its code, and a code cannot be taken
       * back. Codes will be forwarded, pasted into tickets and left in chat logs. What is
       * exposed is the typed reasoning and the titles and locations of evidence, which may name
       * artefacts marked above Unclassified even though no such artefact is held here. Treat a
       * leaked code as a disclosure of the assessment.
       *
       * WHAT IT DOES NOT COST
       *
       * Not enumeration: `list` below still needs an account, and no rule can be written that
       * permits a query filtered on a code, because rules can read a query's limit, its offset
       * and its ordering and nothing about a filter.
       *
       * Not a lookup fee: `if true` reads no document to decide, so the common path costs the
       * one read it was always going to cost.
       */
      allow get: if true;

      // Unchanged, and the load-bearing line in this file. An assessor keeps an account,
      // because handing one person the whole pool is the one job no code can do.
      allow list: if isAssessor();

      /**
       * The owner changes their own record. Whoever holds the code may change it too, because
       * that is what sharing an assessment means here: two people filling in 176 questions
       * together, and the tool cannot tell a co-author from the owner, so it does not pretend
       * to.
       *
       * Four things are frozen against a code holder, each of them an act that would be
       * invisible to the owner:
       *
       *   ownerEmail   moving the record into somebody else's account
       *   fileType     changing what it is, which hides it from the assessor's list
       *   audit        forging or erasing an assessor's verdict, which is a field of this
       *                document and not of the subcollection below
       *   withdrawnAt  pulling a record out of the statistics
       *
       * And the five structural keys must all be present, because the page sends the whole
       * document with no updateMask, so a short body would otherwise replace the rest of it
       * with nothing.
       *
       * meta.submittedAt is deliberately NOT frozen. A co-author holding the code is somebody
       * working on the assessment, and saying it is finished is part of that work.
       */
      allow update: if (isOwner() && request.resource.data.ownerEmail == resource.data.ownerEmail)
                    || codeWriteIsClean();

      // Admin only, and the tool makes them type the initiative name first. Somebody holding a
      // code can damage an assessment and can never remove it.
      allow delete: if isAdmin();

      // The audit trail as a subcollection. Nothing in src/ writes here yet; the audit the tool
      // actually keeps is a field of the assessment, frozen against a code holder above. This
      // stays closed until there is something in it.
      match /audit/{entry} {
        allow get, list: if isOwner() || isAssessor();
        allow create, update: if isAssessor();
        allow delete: if isAdmin();
      }
    }

    /** The shape of a code this tool mints: twelve characters, I O 0 and 1 left out. */
    function isCodeShaped(id) {
      return id.matches('^[A-HJ-NP-Z2-9]{12}$');
    }

    /** The five parts every assessment carries. Not a security control: a shape check. */
    function looksLikeAnAssessment() {
      return request.resource.data.get('fileType', '') == 'gc-arch-assessment'
        && request.resource.data.keys().hasAll(['fileType', 'rubric', 'initiative', 'answers', 'meta']);
    }

    /**
     * What somebody holding only an access code may not change.
     *
     * Read what this is and what it is not. It is not an access control: the access control is
     * the document id, and anybody who has it has passed already. This is damage limitation,
     * and its whole job is to keep a code holder out of the fields that would let them tell a
     * lie the owner could not see.
     */
    function codeWriteIsClean() {
      return request.resource.data.get('ownerEmail', '') == resource.data.get('ownerEmail', '')
        && request.resource.data.get('fileType', '') == resource.data.get('fileType', '')
        && request.resource.data.get('audit', {}) == resource.data.get('audit', {})
        && request.resource.data.get('withdrawnAt', '') == resource.data.get('withdrawnAt', '')
        && request.resource.data.keys().hasAll(['fileType', 'rubric', 'initiative', 'answers', 'meta']);
    }

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function email() {
      return request.auth.token.email;
    }
    function isOwner() {
      return signedIn() && resource.data.ownerEmail == email();
    }
    function roleOf() {
      return exists(/databases/$(database)/documents/roles/$(email()))
        ? get(/databases/$(database)/documents/roles/$(email())).data.role
        : 'submitter';
    }
    function isAssessor() {
      return signedIn() && (roleOf() == 'assessor' || roleOf() == 'admin');
    }
    function isAdmin() {
      return signedIn() && roleOf() == 'admin';
    }
  }
}
