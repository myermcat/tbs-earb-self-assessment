{
  "name": "gc-arch-self-assessment",
  "version": "0.1.0",
  "private": true,
  "description": "Self-assessment instrument replacing the GC EARB architecture template and hand-built score deck. Prototype.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "check": "tsc --noEmit",
    "test": "npm run lint:prose && npm run test:logic && npm run test:ui",
    "test:logic": "esbuild test/smoke.ts --bundle --platform=node --format=esm --outfile=test/.smoke.mjs --log-level=warning --loader:.json=json && node test/.smoke.mjs",
    "test:ui": "node build.mjs && node test/ui.mjs",
    "lint:prose": "node tools/prose-lint.mjs"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.0"
  }
}
