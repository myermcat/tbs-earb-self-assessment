node_modules/
.DS_Store
test/.smoke.mjs

# Internal source documents stay off GitHub. They live in this folder locally only.
EARB target state knowledge base/*.pdf

# The Firebase web key. It authorises nothing by itself and the published page carries it, which
# is how Firebase is meant to work. It stays out of git anyway, because GitHub secret scanning
# flags the shape and a second copy in a second repository buys nothing. To recreate the file:
# Firebase console, Project settings, the web app, SDK setup and configuration. Copy apiKey and
# projectId into deploy/firebase-config.json.
deploy/firebase-config.json

# Worktrees. A second session works this repository in its own checkout under here, so the
# directory is machine-local and shows up as untracked noise in both sessions otherwise.
.claude/worktrees/

# The working material moved out of this folder on 28 September 2026, into
# ../TBS fall (working material)/, so that keeping it unpublished is a folder boundary rather
# than four lines somebody has to remember. These lines stay as a net: if a recorded meeting or
# one of Dan's spreadsheets is ever copied back in here, git still will not take it.
#
# They were tracked until 21 September 2026, and the history was rewritten that day so the
# repository could be made public. It is public. Adding a file to it is a decision to publish.
Colleague meeting transcripts/
Concept case/
Categories spreadsheet/
EARB target state knowledge base/

# The Firebase CLI keeps a login token here. It is a credential and it never goes to GitHub.
deploy/.firebase/

# Left behind by the Firestore emulator when npm run test:rules runs.
firestore-debug.log
firebase-debug.log

# A Google service-account key. It is a real credential: it signs as the Firebase Admin SDK and
# can read and write the whole store. One was downloaded on 28 September and landed in this
# folder, untracked but not ignored, in a repository that is public. These lines exist so that
# `git add -A` cannot publish the next one. Keys belong OUTSIDE this folder entirely, which is
# why deploy/make-signin-link.mjs refuses to read one from inside it.
*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].json
*service-account*.json
*serviceaccount*.json
*-key.json
# Belt and braces: a key saved with this shape, which the link generator suggests against.
deploy/*.json.key
